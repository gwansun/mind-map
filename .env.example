# Mind Map Configuration

# API Keys for LLM providers
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# Ollama host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Memo --local target: any OpenAI-compatible endpoint (defaults to local
# http://127.0.0.1:11435/v1). Example for DeepSeek:
#   MIND_MAP_LOCAL_BASE_URL=https://api.deepseek.com/v1
#   MIND_MAP_LOCAL_API_KEY=your-deepseek-api-key
# When MIND_MAP_LOCAL_API_KEY is unset, no Authorization header is sent.
#MIND_MAP_LOCAL_BASE_URL=
#MIND_MAP_LOCAL_API_KEY=

# ChromaDB persistence path
CHROMA_PERSIST_PATH=./data/chroma

# SQLite database path for edge registry
SQLITE_DB_PATH=./data/edges.db
