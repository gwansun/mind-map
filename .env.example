# Mind Map Configuration

# API Keys for LLM providers
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# Ollama host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Default cloud target: the CommandCode gateway (OpenAI-compatible,
# https://api.commandcode.ai/provider/v1). Both LLM paths use this route —
# memo ingestion and `ask` reasoning. Legacy fallback: MINIMAX_API_KEY ->
# api.minimax.io. Neither set -> memo fails unless --local.
COMMANDCODE_API_KEY=your-commandcode-api-key

# Model override (optional; default deepseek/deepseek-v4.1-flash).
# The `deepseek/` namespace is required — the gateway rejects bare aliases.
#MIND_MAP_LLM_MODEL=deepseek/deepseek-v4.1-flash

# Gateway base URL override (optional; do not include /chat/completions).
#MIND_MAP_LLM_BASE_URL=https://api.commandcode.ai/provider/v1
# Legacy pre-CommandCode alias, still honoured: MIND_MAP_DEEPSEEK_MODEL

# Memo --local target: any OpenAI-compatible endpoint (defaults to local
# http://127.0.0.1:11435/v1).
# When MIND_MAP_LOCAL_API_KEY is unset, no Authorization header is sent.
#MIND_MAP_LOCAL_BASE_URL=
#MIND_MAP_LOCAL_API_KEY=

# ChromaDB persistence path
CHROMA_PERSIST_PATH=./data/chroma

# SQLite database path for edge registry
SQLITE_DB_PATH=./data/edges.db
